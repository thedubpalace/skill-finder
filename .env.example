# Copy this file to .env and fill in values

# Embedding backend: "local" (sentence-transformers, no key needed) or "openai"
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Required only when EMBEDDING_BACKEND=openai
OPENAI_API_KEY=

# Optional — raises GitHub API rate limit from 10 to 30 req/min
GITHUB_TOKEN=

# Server
HOST=127.0.0.1
PORT=8000
